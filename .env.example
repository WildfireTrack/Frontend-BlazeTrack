# ---------------------------------------------------------------------------
# WildFire Tracker — Environment Variables
# Copy this file to `.env.local` and fill in values as features are added.
# Only variables prefixed with NEXT_PUBLIC_ are exposed to the browser.
# ---------------------------------------------------------------------------

# App metadata
NEXT_PUBLIC_APP_NAME="WildFire Tracker"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Map configuration (MapLibre GL / react-map-gl)
# Optional custom style URL or tile-provider key used in later phases.
NEXT_PUBLIC_MAP_STYLE_URL=
NEXT_PUBLIC_MAPTILER_API_KEY=

# Wildfire data source (Phase 2+ — no backend wired yet)
NEXT_PUBLIC_API_BASE_URL=
